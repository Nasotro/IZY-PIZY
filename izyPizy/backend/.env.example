# IZY PIZY backend configuration
#
# LOCAL MODE (offline, no external APIs):
#   This is AUTO-ENABLED when no image-generation API key is set below.
#   In local mode the backend runs without Firebase and without any API key:
#   - auth is local (no account needed),
#   - images are generated locally as placeholders,
#   - all data lives in the local SQLite database (../data/izypizy.db).
#
#   You can force it on/off explicitly:
# LOCAL_MODE=true

# --- Real API keys (optional; only needed when NOT in local mode) ---
BFL_API_KEY=
# RUNWARE_API_KEY=
# MISTRAL_API_KEY=

# --- Firebase Admin credentials (optional in local mode) ---
# Either set FIREBASE_CREDENTIALS_JSON or drop a firebase-creds.json file
# next to this file.
# FIREBASE_CREDENTIALS_JSON=
